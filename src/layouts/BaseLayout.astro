---
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import profilePhoto from '../assets/images/mateo-mino.jpg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL('/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const ogAlt = 'Mateo Miño, Investigador OSINT en Quito, Ecuador';
const photo = await getImage({ src: profilePhoto, width: 600, format: 'jpg' });
// Sin teléfono, domicilio ni email (reglas OPSEC del spec, sección 2)
const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: '2023-12-16T10:10:37-05:00',
  dateModified: new Date().toISOString(),
  mainEntity: {
    '@type': 'Person',
    '@id': `${home}#person`,
    name: 'Mateo Miño',
    alternateName: 'Mino-Mateo',
    description:
      'Investigador OSINT especializado en escaneo de endpoints para detectar fugas de datos y consultas expuestas, con divulgación responsable.',
    jobTitle: 'Investigador OSINT',
    url: home,
    image: new URL(photo.src, Astro.site).href,
    address: { '@type': 'PostalAddress', addressLocality: 'Quito', addressCountry: 'EC' },
    worksFor: { '@type': 'Organization', name: 'eCondor Digital', url: 'https://econdordigital.org/' },
    alumniOf: { '@type': 'EducationalOrganization', name: 'Escuela Politécnica Nacional', url: 'https://www.epn.edu.ec/' },
    knowsAbout: [
      'OSINT',
      'Ciberinteligencia',
      'Escaneo de endpoints',
      'Fuzzing',
      'Detección de filtraciones de datos',
      'Divulgación responsable',
      'Seguridad digital',
    ],
    sameAs: [
      'https://github.com/Mino-Mateo',
      'https://www.linkedin.com/in/mateo-mi%C3%B1o/',
      'https://www.youtube.com/@mateomino-vc4hl',
    ],
  },
};
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mateo Miño" />
    <meta name="theme-color" content="#010101" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mateo Miño" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(profile)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Nav />
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Respaldo: WebKit a veces no avisa al observer si el scroll salta (enlace a una sección,
      // scroll rápido). Todo lo que ya entró en pantalla se revela igual, para no dejarlo invisible.
      let pendiente = false;
      const revisar = () => {
        pendiente = false;
        const ocultos = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (!ocultos.length) return removeEventListener('scroll', alScroll);
        for (const el of ocultos) {
          if (el.getBoundingClientRect().top < innerHeight) {
            el.classList.add('is-visible');
            io.unobserve(el);
          }
        }
      };
      const alScroll = () => {
        if (!pendiente) requestAnimationFrame(revisar);
        pendiente = true;
      };
      addEventListener('scroll', alScroll, { passive: true });
    </script>
  </body>
</html>
