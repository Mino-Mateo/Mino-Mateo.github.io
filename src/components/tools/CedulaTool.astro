---
import DemoCard from "./DemoCard.astro";
import { IdCard } from "@lucide/astro";
import { paises } from "../../lib/validators";
---
<DemoCard id="demo-cedula" titulo="Verificador de identificación" resumen="Cédula, RUT, CURP o CPF por su dígito verificador" local={true}>
  <IdCard slot="icon" size={22} />
  <div class="tool-info">
    <p class="tool-desc">
      Verificador de números de identificación por país. El cálculo corre
      100% en tu navegador: no se guarda ni se envía ningún dato.
    </p>
    <a
      class="btn btn-ghost"
      href="https://github.com/Mino-Mateo/Verificador-de-C-dula"
    >
      Ver código en GitHub
    </a>
  </div>

  <div class="tool-demo">
    <form class="tool-form" id="cedula-form">
      <div class="tool-field">
        <label for="cedula-pais">País / documento</label>
        <select id="cedula-pais" name="pais">
          {paises.map((p) => <option value={p.id}>{p.nombre}</option>)}
        </select>
      </div>
      <div class="tool-field">
        <label for="cedula-valor">Número</label>
        <input id="cedula-valor" name="valor" type="text" autocomplete="off" />
      </div>
      <button type="submit" class="btn btn-primary">Verificar</button>
    </form>

    <div id="cedula-result" class="tool-result" role="status"></div>
    <p id="cedula-anat-titulo" class="anat-titulo">Cómo se lee (ejemplo ficticio)</p>
    <div id="cedula-anatomia" class="anat"></div>
  </div>
</DemoCard>

<script>
  import { paises } from "../../lib/validators";
  import { anatomia } from "../../lib/validators/anatomia";
  import { dibujarAnatomia } from "../../lib/anatomia-dom";

  const form = document.querySelector<HTMLFormElement>("#cedula-form");
  const paisSelect = document.querySelector<HTMLSelectElement>("#cedula-pais");
  const valorInput = document.querySelector<HTMLInputElement>("#cedula-valor");
  const resultBox = document.querySelector<HTMLDivElement>("#cedula-result");
  const anatCaja = document.querySelector<HTMLDivElement>("#cedula-anatomia");
  const anatTitulo = document.querySelector<HTMLParagraphElement>("#cedula-anat-titulo");

  // Sin número propio se explica el ejemplo ficticio del país elegido
  function explicar(valor: string | null) {
    const pais = paises.find((p) => p.id === paisSelect?.value);
    if (!pais || !anatCaja || !anatTitulo) return;
    const segs = anatomia(pais.id, valor ?? pais.placeholder);
    anatTitulo.textContent = valor ? "Cómo se lee tu número" : "Cómo se lee (ejemplo ficticio)";
    anatTitulo.hidden = !segs;
    dibujarAnatomia(anatCaja, segs);
  }

  function actualizarPlaceholder() {
    const pais = paises.find((p) => p.id === paisSelect?.value);
    if (pais && valorInput) valorInput.placeholder = pais.placeholder;
  }

  paisSelect?.addEventListener("change", () => {
    actualizarPlaceholder();
    explicar(null);
  });
  actualizarPlaceholder();
  explicar(null);

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const pais = paises.find((p) => p.id === paisSelect?.value);
    if (!pais || !valorInput || !resultBox) return;

    const resultado = pais.validar(valorInput.value);

    resultBox.textContent = resultado.mensaje;
    resultBox.classList.toggle("valido", resultado.valido);
    resultBox.classList.toggle("invalido", !resultado.valido);
    explicar(valorInput.value);
  });
</script>
