---
---
<div class="card tool-card" data-reveal>
  <div class="tool-info">
    <h3>Verificador de tarjeta</h3>
    <p class="tool-desc">
      Valida un número de tarjeta con el algoritmo de Luhn e identifica la marca
      (Visa, Mastercard, American Express, Discover, Diners Club, JCB, UnionPay, Maestro)
      por su prefijo y longitud. Es cálculo puro: corre en tu navegador, no consulta
      ningún banco y no confirma que la tarjeta exista.
    </p>
    <p class="tool-desc">Usa números de prueba, por ejemplo 4242 4242 4242 4242.</p>
    <a class="btn btn-ghost" href="https://github.com/Mino-Mateo/Verificador-de-Tarjeta">
      Ver código en GitHub
    </a>
  </div>

  <div class="tool-demo">
    <form class="tool-form" id="tarjeta-form">
      <div class="tool-field">
        <label for="tarjeta-valor">Número de tarjeta</label>
        <input
          id="tarjeta-valor"
          name="valor"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          maxlength="23"
          placeholder="4242 4242 4242 4242"
        />
      </div>
      <button type="submit" class="btn btn-primary">Verificar</button>
    </form>

    <div id="tarjeta-result" class="tool-result" role="status"></div>
    <div id="tarjeta-luhn" class="luhn" aria-hidden="true" hidden>
      <div id="tarjeta-celdas" class="luhn-celdas"></div>
      <p id="tarjeta-suma" class="luhn-suma"></p>
      <p class="luhn-leyenda"><span class="luhn-muestra"></span> dígito duplicado (si pasa de 9, se resta 9)</p>
    </div>
  </div>
</div>

<script>
  import { validarTarjeta } from "../../lib/validators/tarjeta";

  const form = document.querySelector<HTMLFormElement>("#tarjeta-form");
  const input = document.querySelector<HTMLInputElement>("#tarjeta-valor");
  const resultBox = document.querySelector<HTMLDivElement>("#tarjeta-result");
  const luhn = document.querySelector<HTMLDivElement>("#tarjeta-luhn");
  const celdas = document.querySelector<HTMLDivElement>("#tarjeta-celdas");
  const sumaEl = document.querySelector<HTMLParagraphElement>("#tarjeta-suma");
  const sinMovimiento = matchMedia("(prefers-reduced-motion: reduce)");
  let timers: ReturnType<typeof setTimeout>[] = [];

  // Agrupa en bloques de 4 solo si se escribe al final, para no mover el cursor a mitad del número
  input?.addEventListener("input", () => {
    if (input.selectionStart !== input.value.length) return;
    const digitos = input.value.replace(/\D/g, "").slice(0, 19);
    input.value = digitos.replace(/(\d{4})(?=\d)/g, "$1 ");
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!input || !resultBox || !luhn || !celdas || !sumaEl) return;

    const r = validarTarjeta(input.value);
    resultBox.textContent = r.suma === null ? r.mensaje : `${r.mensaje}. Suma de Luhn: ${r.suma}.`;
    resultBox.classList.toggle("valido", r.valido);
    resultBox.classList.toggle("invalido", !r.valido);

    timers.forEach(clearTimeout);
    timers = [];
    luhn.hidden = r.pasos.length === 0;
    celdas.replaceChildren(
      ...r.pasos.map((p) => {
        const celda = document.createElement("span");
        celda.className = p.duplicado ? "luhn-celda dup" : "luhn-celda";
        const arriba = document.createElement("span");
        arriba.textContent = String(p.digito);
        const abajo = document.createElement("span");
        abajo.textContent = String(p.valor);
        celda.append(arriba, abajo);
        return celda;
      })
    );
    if (r.suma !== null) sumaEl.textContent = `Suma ${r.suma} · ${r.suma} mod 10 = ${r.suma % 10}`;

    // Las celdas aparecen una a una con clases (sin style=, lo bloquea la CSP)
    const lista = [...celdas.children];
    if (sinMovimiento.matches) {
      lista.forEach((c) => c.classList.add("on"));
    } else {
      lista.forEach((c, i) => timers.push(setTimeout(() => c.classList.add("on"), i * 45)));
    }
  });
</script>

<style>
.luhn { margin-top: var(--space-2); }
.luhn-celdas {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
}
.luhn :global(.luhn-celda) {
  display: grid;
  min-width: 1.75rem;
  padding: 0.25rem 0.375rem;
  border: 1px solid var(--color-border-strong);
  border-radius: 4px;
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  text-align: center;
  opacity: 0;
  transform: translateY(4px);
  transition: opacity var(--dur) ease-out, transform var(--dur) ease-out;
}
.luhn :global(.luhn-celda > span:first-child) { color: var(--color-text-muted); }
.luhn :global(.luhn-celda.dup) {
  border-color: var(--color-accent);
  background: color-mix(in srgb, var(--color-accent) 14%, transparent);
}
.luhn :global(.luhn-celda.dup > span:last-child) { color: var(--color-accent); font-weight: 600; }
.luhn :global(.luhn-celda.on) { opacity: 1; transform: none; }
.luhn-suma,
.luhn-leyenda {
  margin: var(--space-1) 0 0;
  font-family: var(--font-mono);
  font-size: 0.75rem;
}
.luhn-muestra {
  display: inline-block;
  width: 0.75rem;
  height: 0.75rem;
  vertical-align: -0.1rem;
  border: 1px solid var(--color-accent);
  background: color-mix(in srgb, var(--color-accent) 14%, transparent);
}

@media (prefers-reduced-motion: reduce) {
  .luhn :global(.luhn-celda) { transition: none; transform: none; }
}
</style>
