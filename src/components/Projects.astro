---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---
<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title" data-reveal><span class="section-index" aria-hidden="true">03</span>Proyectos</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard
          name={project.name}
          description={project.description}
          role={project.role}
          stack={project.stack}
          image={project.image}
          imagePosition={project.imagePosition}
        />
      ))}
    </div>
  </div>
</section>

<style>
.projects-grid {
  display: grid;
  gap: var(--space-3);
}
@media (min-width: 768px) {
  .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .projects-grid > :global(:nth-child(even)) { --i: 1; }
}
</style>
