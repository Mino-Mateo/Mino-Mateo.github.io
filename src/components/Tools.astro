---
import CedulaTool from "./tools/CedulaTool.astro";
import GeoquitoTool from "./tools/GeoquitoTool.astro";
---
<section id="tools" class="section">
  <div class="container">
    <div data-reveal>
      <h2 class="section-title"><span class="section-index">04</span>Herramientas</h2>
      <p class="tools-intro">
        Un aperitivo de lo que se puede construir: demos interactivos, en vivo,
        de herramientas reales.
      </p>
    </div>

    <div class="tools-grid">
      <CedulaTool />
      <GeoquitoTool />
    </div>
  </div>
</section>

<style>
.tools-intro { margin: 0 0 var(--space-4); }
.tools-grid {
  display: grid;
  gap: var(--space-4);
}
:global(.tool-card) {
  display: grid;
  gap: var(--space-3);
  padding: var(--space-3);
}
@media (min-width: 768px) {
  :global(.tool-card) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding: var(--space-4);
  }
  :global(.tool-card-reverse .tool-info) { order: 2; }
}
:global(.tool-info h3) { margin-bottom: var(--space-1); }
:global(.tool-desc) {
  font-size: 0.875rem;
  margin: 0 0 var(--space-3);
}
:global(.tool-form) {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  align-items: flex-end;
}
:global(.tool-field) {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  flex: 1 1 12rem;
}
:global(.tool-field input),
:global(.tool-field select) { width: 100%; }
:global(.tool-result) {
  margin-top: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius);
  font-family: var(--font-mono);
  font-size: 0.875rem;
}
/* Vacío: sin caja visible, pero sigue en el árbol de accesibilidad para anunciar cambios */
:global(.tool-result:empty) {
  margin: 0;
  padding: 0;
  border: 0;
}
:global(.tool-result.valido) {
  border-color: var(--color-accent);
  color: var(--color-accent);
}
:global(.tool-result.invalido) {
  border-color: var(--color-error);
  color: var(--color-error);
}
</style>
