---
import CedulaTool from "./tools/CedulaTool.astro";
import GeoquitoTool from "./tools/GeoquitoTool.astro";
---
<section id="tools" class="section">
  <div class="container">
    <h2 class="section-title">[ 04 ] Herramientas</h2>
    <p class="tools-intro">
      Un aperitivo de lo que se puede construir: demos interactivos, en vivo,
      de herramientas reales.
    </p>

    <div class="tools-grid">
      <CedulaTool />
      <GeoquitoTool />
    </div>
  </div>
</section>

<style>
.tools-intro {
  color: var(--color-text-muted);
  max-width: 600px;
  margin-bottom: var(--space-3);
}
.tools-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
:global(.tool-card) {
  border: 1px solid var(--color-border);
  background: var(--color-bg-elevated);
  padding: var(--space-3);
}
:global(.tool-card h3) {
  font-size: 1.1rem;
  margin-bottom: var(--space-1);
}
:global(.tool-desc) {
  color: var(--color-text-muted);
  max-width: 600px;
  margin-bottom: var(--space-2);
  font-size: 0.9rem;
}
:global(.tool-repo-link) {
  display: inline-block;
  margin-bottom: var(--space-3);
}
:global(.tool-form) {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  align-items: flex-end;
  max-width: 600px;
}
:global(.tool-field) {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
:global(.tool-field label) {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--color-text-muted);
}
:global(.tool-field select),
:global(.tool-field input) {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  color: var(--color-text);
  padding: 0.6rem;
  font-family: var(--font-sans);
  min-width: 200px;
}
:global(.tool-field select:focus),
:global(.tool-field input:focus) {
  outline: none;
  border-color: var(--color-accent);
}
:global(.tool-result) {
  margin-top: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--color-border);
  font-family: var(--font-mono);
  font-size: 0.9rem;
  max-width: 600px;
}
:global(.tool-result.valido) {
  border-color: var(--color-accent);
  color: var(--color-accent);
}
:global(.tool-result.invalido) {
  border-color: var(--color-error);
  color: var(--color-error);
}
</style>
