---
import CedulaTool from "./tools/CedulaTool.astro";
import GeoquitoTool from "./tools/GeoquitoTool.astro";
import TarjetaTool from "./tools/TarjetaTool.astro";
import ExifTool from "./tools/ExifTool.astro";
import DominioTool from "./tools/DominioTool.astro";
---
<section id="tools" class="section">
  <div class="container">
    <div data-reveal>
      <h2 class="section-title"><span class="section-index" aria-hidden="true">04</span>Herramientas</h2>
      <p class="tools-intro">
        Un aperitivo de lo que se puede construir: demos interactivos, en vivo,
        de herramientas reales.
      </p>
    </div>

    <h3 class="tools-group" data-reveal>Validadores algorítmicos</h3>
    <div class="tools-grid">
      <CedulaTool />
      <TarjetaTool />
    </div>

    <h3 class="tools-group" data-reveal>OSINT con fuentes abiertas</h3>
    <div class="tools-grid">
      <GeoquitoTool />
      <DominioTool />
      <ExifTool />
    </div>
  </div>
</section>

<script>
  // /#demo-xxx (desde Proyectos o un enlace compartido) abre esa demo
  function abrirDemo() {
    const d = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (d instanceof HTMLDetailsElement) d.open = true;
  }
  abrirDemo();
  addEventListener("hashchange", abrirDemo);
</script>

<style>
.tools-intro { margin: 0 0 var(--space-4); }
.tools-group {
  margin: var(--space-4) 0 var(--space-3);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}
.tools-grid + .tools-group { margin-top: var(--space-4); }
.tools-grid {
  display: grid;
  gap: var(--space-2);
  align-items: start;
}
@media (min-width: 768px) {
  .tools-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* La demo abierta ocupa todo el ancho; las cerradas quedan como índice */
  .tools-grid :global(.tool-card[open]) { grid-column: 1 / -1; }
}
:global(.tool-card) { padding: 0; }
:global(.tool-summary) {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: var(--space-2);
  align-items: center;
  min-height: 44px;
  padding: var(--space-3);
  border-radius: var(--radius);
  cursor: pointer;
  list-style: none;
  transition: background var(--dur) ease-out;
}
:global(.tool-summary::-webkit-details-marker) { display: none; }
:global(.tool-summary:hover) { background: var(--color-hover); }
:global(.tool-icon) {
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  border: 1px solid var(--color-border-accent);
  border-radius: var(--radius);
  color: var(--color-accent);
}
:global(.tool-head) { display: grid; gap: 0.25rem; justify-items: start; }
:global(.tool-head h3) { margin: 0; }
:global(.tool-resumen) { font-size: 0.875rem; color: var(--color-text-muted); }
:global(.tool-tag) {
  padding: 0.125rem 0.5rem;
  border: 1px solid var(--color-border-accent);
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-accent);
}
:global(.tool-tag-red) { border-color: var(--color-border-strong); color: var(--color-pink); }
:global(.tool-chevron) { color: var(--color-text-muted); transition: transform var(--dur) ease-out; }
:global(.tool-card[open] .tool-chevron) { transform: rotate(180deg); }
:global(.tool-body) {
  display: grid;
  gap: var(--space-3);
  padding: 0 var(--space-3) var(--space-3);
}
@media (min-width: 768px) {
  :global(.tool-body) {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-4);
    padding: 0 var(--space-4) var(--space-4);
  }
}
@media (prefers-reduced-motion: reduce) {
  :global(.tool-chevron), :global(.tool-summary) { transition: none; }
}
/* Anatomía del número: cada parte con su color y su significado */
:global(.rol-origen) { --c: #fa93fa; }
:global(.rol-tipo) { --c: #7dd3fc; }
:global(.rol-datos) { --c: #f5b454; }
:global(.rol-secuencia) { --c: #9ca3af; }
:global(.rol-verificador) { --c: #4ade80; }
:global(.anat-titulo) {
  margin: var(--space-3) 0 var(--space-1);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}
:global(.anat-fila) { display: flex; flex-wrap: wrap; gap: 0.25rem; }
:global(.anat-seg) {
  padding: 0.25rem 0.5rem;
  border: 1px solid var(--c);
  border-radius: 4px;
  background: color-mix(in srgb, var(--c) 18%, transparent);
  font-family: var(--font-mono);
  font-size: 1rem;
  letter-spacing: 0.08em;
  color: var(--color-text);
}
:global(.anat-lista) {
  display: grid;
  gap: 0.25rem;
  margin: var(--space-1) 0 0;
  padding: 0;
  list-style: none;
  font-size: 0.8125rem;
}
:global(.anat-lista li) { display: flex; gap: 0.5rem; align-items: baseline; }
:global(.anat-lista li)::before {
  content: "";
  flex-shrink: 0;
  width: 0.625rem;
  height: 0.625rem;
  border: 1px solid var(--c);
  background: color-mix(in srgb, var(--c) 40%, transparent);
}
:global(.anat-lista strong) { font-family: var(--font-mono); font-weight: 600; color: var(--c); }

@media (max-width: 479px) {
  :global(.tool-summary) { padding: var(--space-2); }
  :global(.tool-body) { padding: 0 var(--space-2) var(--space-2); }
}
:global(.tool-desc) {
  font-size: 0.875rem;
  margin: 0 0 var(--space-3);
}
:global(.tool-form) {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  align-items: flex-end;
}
:global(.tool-field) {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  flex: 1 1 12rem;
}
:global(.tool-field input),
:global(.tool-field select) { width: 100%; }
:global(.tool-result) {
  margin-top: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius);
  font-family: var(--font-mono);
  font-size: 0.875rem;
}
/* Vacío: sin caja visible, pero sigue en el árbol de accesibilidad para anunciar cambios */
:global(.tool-result:empty) {
  margin: 0;
  padding: 0;
  border: 0;
}
:global(.tool-result.valido) {
  border-color: var(--color-accent);
  color: var(--color-accent);
}
:global(.tool-result.invalido) {
  border-color: var(--color-error);
  color: var(--color-error);
}
:global(.tool-table) {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.25rem var(--space-2);
  margin: var(--space-2) 0 0;
  font-size: 0.875rem;
  overflow-wrap: anywhere;
}
:global(.tool-table dt) { color: var(--color-text-muted); }
:global(.tool-table dd) { margin: 0; }
</style>
