---
import { ArrowUp } from "@lucide/astro";
import EmailLink from "./EmailLink.astro";

const socials = [
  { href: "https://github.com/Mino-Mateo", label: "GitHub" },
  { href: "https://www.linkedin.com/in/mateo-miño/", label: "LinkedIn" },
  { href: "https://www.youtube.com/@mateomino-vc4hl", label: "YouTube" },
];
---
<footer class="footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><EmailLink /></li>
      {socials.map((s) => (
        <li><a href={s.href}>{s.label}</a></li>
      ))}
    </ul>
    <a href="/#home" class="back-to-top">
      <ArrowUp size={16} />
      Volver arriba
    </a>
  </div>
  <p class="container footer-privacy">Sin cookies ni analítica. Solo se contacta a terceros cuando llegas al mapa.</p>
</footer>

<style>
.footer { padding: var(--space-4) 0; }
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.footer-links {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  column-gap: var(--space-3);
  margin: 0;
  padding: 0;
}
.footer-links :global(a),
.back-to-top {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  min-height: 44px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-text-muted);
  transition: color var(--dur) ease-out;
}
.footer-links :global(a:hover),
.back-to-top:hover { color: var(--color-accent); text-decoration: none; }
.footer-privacy {
  margin-top: var(--space-2);
  font-size: 0.75rem;
}
</style>
