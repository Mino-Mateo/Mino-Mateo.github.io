---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import econdorLogo from "../assets/images/econdor-logo.png";
---
<section id="company" class="section">
  <div class="container" data-reveal>
    <h2 class="section-title"><span class="section-index" aria-hidden="true">06</span>eCondor Digital</h2>
    <div class="company-brand">
      <Image
        class="company-logo"
        src={econdorLogo}
        alt=""
        width={56}
        height={56}
        widths={[56, 112]}
        sizes="56px"
        loading="lazy"
      />
      <h3>Software minimalista y moderno</h3>
    </div>
    <p class="company-desc">
      eCondor Digital es la empresa que cofundé. Como Cofundador y Tech Lead dirijo
      la parte técnica y de seguridad digital: cada producto sale con la misma
      revisión de superficie expuesta que aplico en mis investigaciones. Construimos
      productos web y móviles a medida: backend y APIs, UI/UX, consultoría técnica y MVPs.
    </p>
    <a class="btn btn-primary" href="https://econdordigital.org/" target="_blank" rel="noopener">
      econdordigital.org<ArrowUpRight size={16} /><span class="sr-only"> (se abre en otra pestaña)</span>
    </a>
  </div>
</section>

<style>
.company-brand {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}
.company-brand h3 { margin: 0; }
.company-logo {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
}
.company-desc { margin-bottom: var(--space-3); }
</style>
