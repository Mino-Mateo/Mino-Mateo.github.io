---
import { Image } from "astro:assets";
import profilePhoto from "../assets/images/mateo-mino.jpg";
---
<section id="home" class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container hero-content">
    <Image
      class="hero-photo"
      src={profilePhoto}
      alt="Foto de Mateo Miño"
      width={280}
      height={280}
    />
    <div class="hero-text">
      <p class="section-title">Ciberseguridad · Inteligencia · OSINT</p>
      <h1>Mateo Miño</h1>
      <p class="hero-bio">
        Tech Lead & Seguridad Digital. Diseño y construyo herramientas de
        inteligencia, investigación e infraestructura segura.
      </p>
      <div class="hero-links">
        <a class="btn" href="https://github.com/Mino-Mateo" target="_blank" rel="noopener">GitHub</a>
        <a class="btn btn-outline" href="https://www.linkedin.com/in/mateo-miño/" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  padding: var(--space-8) 0;
  overflow: hidden;
  border-bottom: 1px solid var(--color-border);
  scroll-margin-top: 5rem;
}
.hero-grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--color-border) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
  background-size: 40px 40px;
  opacity: 0.05;
  pointer-events: none;
}
.hero-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.hero-photo {
  width: 140px;
  height: 140px;
  object-fit: cover;
  border: 1px solid var(--color-border);
  flex-shrink: 0;
}
.hero-text { flex: 1; min-width: 260px; }
.hero-bio {
  max-width: 560px;
  color: var(--color-text-muted);
  margin-bottom: var(--space-3);
}
.hero-links { display: flex; gap: var(--space-2); flex-wrap: wrap; }
</style>
