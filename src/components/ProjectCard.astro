---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  description: string;
  role: string;
  stack: string[];
  image: ImageMetadata;
  imagePosition?: string;
}
const { name, description, role, stack, image, imagePosition } = Astro.props;
---
<article class="card project-card" data-reveal>
  <Image
    class="card-image"
    src={image}
    alt={`Captura del proyecto ${name}`}
    width={960}
    height={480}
    widths={[480, 960, 1280]}
    sizes="(min-width: 1280px) 604px, (min-width: 768px) 50vw, 100vw"
    loading="lazy"
    style={imagePosition && `object-position: ${imagePosition}`}
  />
  <div class="card-body">
    <h3>{name}</h3>
    <p class="card-desc">{description}</p>
    <p class="card-role"><span class="label">ROL:</span> {role}</p>
    <div class="card-stack">
      {stack.map((tech) => <span class="tag">{tech}</span>)}
    </div>
  </div>
</article>

<style>
.project-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: border-color var(--dur) ease-out;
}
.project-card:hover { border-color: var(--color-border-accent); }
.card-image {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 2 / 1;
  object-fit: cover;
  object-position: top;
  border-bottom: 1px solid var(--color-border);
  opacity: 0.85;
  transition: opacity var(--dur) ease-out;
}
.project-card:hover .card-image { opacity: 1; }
.card-body {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-3);
}
.card-body > * { margin: 0; }
.card-desc { flex-grow: 1; font-size: 0.875rem; }
.card-role { font-size: 0.875rem; }
.label { font-family: var(--font-mono); color: var(--color-accent); }
.card-stack { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1); }
</style>
